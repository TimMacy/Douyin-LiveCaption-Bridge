{
    "manifest_version": 3,
    "name": "Douyin Live Caption Bridge",
    "version": "4.0",
    "description": "Routes Douyin Live tab audio through Web Audio so Chrome Live Caption can detect it.",
    "permissions": [
        "activeTab",
        "tabCapture"
    ],
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "background": {
        "service_worker": "service-worker.js"
    },
    "action": {
        "default_title": "Start Douyin Live Caption Bridge"
    },
    "minimum_chrome_version": "133"
}
